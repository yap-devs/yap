@@ -0,0 +1,79 @@
+package dispatcher
+
+import (
+	"context"
+	"fmt"
+	"testing"
+
+	appstats "github.com/v2fly/v2ray-core/v5/app/stats"
+	"github.com/v2fly/v2ray-core/v5/common/buf"
+	"github.com/v2fly/v2ray-core/v5/common/net"
+	"github.com/v2fly/v2ray-core/v5/common/protocol"
+	"github.com/v2fly/v2ray-core/v5/common/session"
+	"github.com/v2fly/v2ray-core/v5/features/policy"
+)
+
+type yapPolicy struct{}
+
+func (yapPolicy) Type() interface{} { return policy.ManagerType() }
+func (yapPolicy) Start() error      { return nil }
+func (yapPolicy) Close() error      { return nil }
+func (yapPolicy) ForLevel(uint32) policy.Session {
+	return policy.Session{Stats: policy.Stats{UserUplink: true, UserDownlink: true}}
+}
+func (yapPolicy) ForSystem() policy.System { return policy.System{} }
+
+func TestYAPPortStats(t *testing.T) {
+	sm, err := appstats.NewManager(context.Background(), &appstats.Config{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	d := &DefaultDispatcher{policy: yapPolicy{}, stats: sm}
+	user := &protocol.MemoryUser{Email: "user-42"}
+	cases := []struct {
+		tag      string
+		port     net.Port
+		network  net.Network
+		suffix   string
+		up, down int
+	}{
+		{"yap-shared", 10001, net.Network_TCP, "-port-10001", 13, 29},
+		{"yap-shared", 10002, net.Network_TCP, "-port-10002", 7, 11},
+		{"yap-shared", 10001, net.Network_TCP, "-port-10001", 17, 19},
+		{"legacy", 10001, net.Network_TCP, "", 3, 5},
+		{"yap-shared", 0, net.Network_TCP, "", 2, 4},
+		{"yap-shared", 10001, net.Network_UDP, "", 6, 8},
+	}
+	expected := map[string]int64{}
+	for _, tc := range cases {
+		ctx := session.ContextWithInbound(context.Background(), &session.Inbound{Tag: tc.tag, User: user, Gateway: net.Destination{Network: tc.network, Address: net.LocalHostIP, Port: tc.port}})
+		inbound, outbound := d.getLink(ctx)
+		if err := inbound.Writer.WriteMultiBuffer(buf.MergeBytes(nil, make([]byte, tc.up))); err != nil {
+			t.Fatal(err)
+		}
+		b, err := outbound.Reader.ReadMultiBuffer()
+		if err != nil {
+			t.Fatal(err)
+		}
+		buf.ReleaseMulti(b)
+		if err := outbound.Writer.WriteMultiBuffer(buf.MergeBytes(nil, make([]byte, tc.down))); err != nil {
+			t.Fatal(err)
+		}
+		b, err = inbound.Reader.ReadMultiBuffer()
+		if err != nil {
+			t.Fatal(err)
+		}
+		buf.ReleaseMulti(b)
+		expected[fmt.Sprintf("user>>>user-42%s>>>traffic>>>uplink", tc.suffix)] += int64(tc.up)
+		expected[fmt.Sprintf("user>>>user-42%s>>>traffic>>>downlink", tc.suffix)] += int64(tc.down)
+		if user.Email != "user-42" {
+			t.Fatal("authentication identity was mutated")
+		}
+	}
+	for name, want := range expected {
+		counter := sm.GetCounter(name)
+		if counter == nil || counter.Value() != want {
+			t.Fatalf("counter %s: got %v, want %d", name, counter, want)
+		}
+	}
+}
